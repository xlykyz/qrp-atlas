[Service]
Type=oneshot
WorkingDirectory=/home/claire/projects/qrp-atlas
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/claire/projects/qrp-atlas/.env
ExecStart=/home/claire/projects/qrp-atlas/scripts/run_pit_backfill_offline_loop.sh 20260714
RemainAfterExit=yes
StandardOutput=append:/home/claire/projects/qrp-atlas/data/logs/pit_backfill_20260714.load.out
