[Unit]
Description=QRP PIT backfill 20260714 CLEAN+LOAD offline loop
After=network-online.target

[Service]
Type=oneshot
User=qrp-atlas
Group=qrp-atlas
WorkingDirectory=/opt/qrp-atlas
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/qrp-atlas/qrp-atlas.env
ExecStart=/opt/qrp-atlas/scripts/run_pit_backfill_offline_loop.sh 20260714
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
