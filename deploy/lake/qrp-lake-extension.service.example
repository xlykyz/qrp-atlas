[Unit]
Description=QRP lake isolated extension code location
After=network.target

[Service]
Type=simple
User=qrp-lake-extension
Group=qrp-lake-readers
WorkingDirectory=/opt/qrp-lake
EnvironmentFile=/etc/qrp-lake/extension.env
ExecStart=/opt/qrp-lake/.venv/bin/dagster api grpc -h 127.0.0.1 -p 4262 -m qrp_atlas.pipeline.lake.extension_location
Restart=on-failure
KillMode=control-group
TimeoutStopSec=30
MemoryHigh=6G
MemoryMax=8G
CPUQuota=200%
TasksMax=64
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/qrp-lake/core
ReadWritePaths=/var/lib/qrp-lake/extension /var/lib/qrp-lake/extension-runtime /var/lib/qrp-lake/dagster
InaccessiblePaths=/etc/qrp-lake/core.env /var/lib/qrp-lake/core-runtime

[Install]
WantedBy=multi-user.target
