[Unit]
Description=QRP PIT backfill 20260714 FETCH only (network)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=qrp-atlas
Group=qrp-atlas
WorkingDirectory=/opt/qrp-atlas
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/qrp-atlas/qrp-atlas.env
ExecStart=/opt/qrp-atlas/.venv/bin/python -m qrp_atlas.pipeline.pit_backfill --mode full --resume --stages fetch --run-tag 20260714 --no-backup
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
