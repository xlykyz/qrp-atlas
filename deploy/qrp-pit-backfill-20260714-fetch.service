[Unit]
Description=QRP PIT backfill 20260714 FETCH only (network)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/qrp-atlas
Environment=PYTHONUNBUFFERED=1
Environment=QRP_PROJECT_ROOT=%h/projects/qrp-atlas
Environment=QRP_ATLAS_ROOT=%h/projects/qrp-atlas
EnvironmentFile=-%h/projects/qrp-atlas/.env
# Portable user-unit paths via %h; override with a drop-in if repo root differs.
ExecStart=%h/projects/qrp-atlas/.venv/bin/python -m qrp_atlas.pipeline.pit_backfill --mode full --resume --stages fetch --run-tag 20260714 --no-backup
RemainAfterExit=yes
StandardOutput=append:%h/projects/qrp-atlas/data/logs/pit_backfill_20260714.fetch.out
StandardError=append:%h/projects/qrp-atlas/data/logs/pit_backfill_20260714.fetch.err
TimeoutStartSec=infinity

[Install]
WantedBy=default.target
