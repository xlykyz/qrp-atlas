[Unit]
Description=QRP Atlas API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qrp-atlas
Group=qrp-atlas
WorkingDirectory=/opt/qrp-atlas
EnvironmentFile=/etc/qrp-atlas/qrp-atlas.env
ExecStartPre=/opt/qrp-atlas/.venv/bin/qrp-atlas-config --env-file /etc/qrp-atlas/qrp-atlas.env doctor
ExecStart=/opt/qrp-atlas/.venv/bin/qrp-atlas-api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
