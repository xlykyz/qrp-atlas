[Unit]
Description=QRP Atlas Pipeline scheduler scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=qrp-atlas
Group=qrp-atlas
WorkingDirectory=/opt/qrp-atlas
EnvironmentFile=/etc/qrp-atlas/qrp-atlas-pipeline.env
ExecStart=/opt/qrp-atlas/.venv/bin/qrp-atlas-pipeline --env-file /etc/qrp-atlas/qrp-atlas.env scan --definitions /etc/qrp-atlas/pipeline-definitions.json --max-catch-up-minutes 360 --heartbeat-interval-seconds 5 --lease-seconds 30 --stale-after-seconds 180
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
