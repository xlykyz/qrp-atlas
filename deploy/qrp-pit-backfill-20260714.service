[Unit]
Description=QRP PIT historical backfill 20260714
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=qrp-atlas
Group=qrp-atlas
WorkingDirectory=/opt/qrp-atlas
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/qrp-atlas/qrp-atlas.env
ExecStart=/opt/qrp-atlas/.venv/bin/python -m qrp_atlas.pipeline.pit_backfill --mode full --resume --stages all --run-tag 20260714 --audit
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
