[Unit]
Description=QRP PIT historical backfill 20260714
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/qrp-atlas
Environment=PYTHONUNBUFFERED=1
Environment=QRP_PROJECT_ROOT=%h/projects/qrp-atlas
Environment=QRP_ATLAS_ROOT=%h/projects/qrp-atlas
EnvironmentFile=-%h/projects/qrp-atlas/.env
ExecStart=%h/projects/qrp-atlas/.venv/bin/python -m qrp_atlas.pipeline.pit_backfill --mode full --resume --stages all --run-tag 20260714 --audit
RemainAfterExit=yes
StandardOutput=append:%h/projects/qrp-atlas/data/logs/pit_backfill_20260714.service.out
StandardError=append:%h/projects/qrp-atlas/data/logs/pit_backfill_20260714.service.err
TimeoutStartSec=infinity

[Install]
WantedBy=default.target
