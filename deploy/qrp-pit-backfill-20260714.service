[Unit]
Description=QRP PIT historical backfill 20260714
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/claire/projects/qrp-atlas
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/claire/projects/qrp-atlas/.env
# stages=all keeps fetch/clean/load decoupled under one process; use --stages fetch to network-only.
ExecStart=/home/claire/projects/qrp-atlas/.venv/bin/python -m qrp_atlas.pipeline.pit_backfill --mode full --resume --stages all --run-tag 20260714 --audit
RemainAfterExit=yes
StandardOutput=append:/home/claire/projects/qrp-atlas/data/logs/pit_backfill_20260714.service.out
StandardError=append:/home/claire/projects/qrp-atlas/data/logs/pit_backfill_20260714.service.err
TimeoutStartSec=infinity

[Install]
WantedBy=default.target
