# Backend API base URL.
# Copy this file to .env.local and point it at the backend you want to use.
VITE_API_BASE_URL=http://localhost:8000

# Backtest workflow source for strategy catalog and tasks:
# - http (default): live product APIs under /api/strategies and /api/backtest/tasks
# - mock: local adapters and fixtures for offline UI development
# VITE_BACKTEST_WORKFLOW_SOURCE=http

# Backtest result source:
# - unset (default): inherit VITE_BACKTEST_WORKFLOW_SOURCE; both default to http
# - http: live run history, results, compare and replay APIs
# - mock: embedded fixtures under src/api/mock
# VITE_BACKTEST_RESULT_SOURCE=http
