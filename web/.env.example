# Frontend API base URL.
# Copy this file to .env.local and point it at the backend API you want to use.
VITE_API_BASE_URL=http://localhost:8000

# Backtest result adapter source for workflow/compare facades:
# - mock (default): embedded fixtures under api/mock
# - http: live GET /api/backtest/*
# VITE_BACKTEST_RESULT_SOURCE=mock

# Backtest workflow adapter source for strategy catalog + tasks:
# - http (default): live product APIs under /api/strategies and /api/backtest/tasks
# - mock: local mock adapters / fixtures for offline UI development
# VITE_BACKTEST_WORKFLOW_SOURCE=http

# Backtest result adapter source:
# - defaults to workflow source when unset
# - mock: embedded fixtures under api/mock
# - http: live GET /api/backtest/*
# VITE_BACKTEST_RESULT_SOURCE=http
