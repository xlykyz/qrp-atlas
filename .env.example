# QRP Atlas runtime configuration template
#
# Copy this file to .env only for local development. Production deployments should
# inject the same names through the service manager or a protected EnvironmentFile.
# Precedence: explicit CLI override > process environment > selected .env > default.
# Keep path variables commented when using their defaults: an explicitly empty path is invalid.

# --- Configuration source ----------------------------------------------------
# Optional | path | default: <repository>/.env | Select another dotenv file.
# Production: prefer an absolute, root-owned path such as /etc/qrp-atlas/qrp-atlas.env.
# QRP_ENV_FILE=/etc/qrp-atlas/qrp-atlas.env

# --- Runtime and persistent paths -------------------------------------------
# Optional | path | default: repository root | Runtime config/log/temp base.
# QRP_HOME=/srv/qrp-atlas/runtime
# Optional | path | default: <repository>/data | DuckDB/raw/canonical/state/results base.
# QRP_DATA_DIR=/srv/qrp-atlas/data
# Optional | file path | default: <QRP_DATA_DIR>/db/quant.db | Advanced DuckDB override.
# QRP_DUCKDB_PATH=/srv/qrp-atlas/data/db/quant.db
# Optional | file path | default: <QRP_DATA_DIR>/db/irm_qa.duckdb | Dedicated IRM Q&A database.
# QRP_IRM_QA_DUCKDB_PATH=/srv/qrp-atlas/data/db/irm_qa.duckdb
# Optional | directory path | default: <QRP_DATA_DIR>/state | Pipeline state and locks.
# QRP_STATE_DIR=/srv/qrp-atlas/data/state
# Optional | directory path | default: <QRP_DATA_DIR>/runtime/job | Isolated Job run metadata.
# QRP_JOB_RUNTIME_DIR=/srv/qrp-atlas/data/runtime/job
# Optional | file path | default: <QRP_JOB_RUNTIME_DIR>/job_runtime.sqlite3 | Job runtime SQLite database.
# QRP_JOB_RUNTIME_DB_PATH=/srv/qrp-atlas/data/runtime/job/job_runtime.sqlite3
# Optional | directory path | default: <QRP_DATA_DIR>/backtest_runs | Backtest result bundles.
# QRP_BACKTEST_RUNS_DIR=/srv/qrp-atlas/data/backtest_runs
# Optional | directory path | default: <QRP_DATA_DIR>/backtest_tasks | Backtest task records.
# QRP_BACKTEST_TASKS_DIR=/srv/qrp-atlas/data/backtest_tasks
# Optional | directory path | default: <QRP_DATA_DIR>/robustness_runs | Robustness outputs.
# QRP_ROBUSTNESS_RUNS_DIR=/srv/qrp-atlas/data/robustness_runs
# Optional | directory path | default: ~/projects/backtest-research/results | Read-only research-workspace backtest runs (exposed at /api/research/*).
# QRP_RESEARCH_RUNS_DIR=/srv/qrp-atlas/research/backtest-research/results
# Optional | directory path | default: <QRP_DATA_DIR>/declarative_strategies | Strategy records.
# QRP_DECLARATIVE_STRATEGIES_DIR=/srv/qrp-atlas/data/declarative_strategies
# Optional | directory path | default: <QRP_HOME>/.runtime/logs | Application logs.
# QRP_LOG_DIR=/srv/qrp-atlas/runtime/logs
# Optional | directory path | default: <QRP_HOME>/.runtime/tmp | Temporary runtime files.
# QRP_TMP_DIR=/srv/qrp-atlas/runtime/tmp

# --- Runtime mode ------------------------------------------------------------
# Optional | boolean | default: false | true forbids configured write-mode operations/init.
# Production read replicas should normally set this to true.
# QRP_READ_ONLY=true
# Optional | enum(development,test,production) | default: development | Enables deployment diagnostics.
# Production services should set production.
# QRP_RUNTIME_ENV=production
# Optional | enum(CRITICAL,ERROR,WARNING,INFO,DEBUG) | default: INFO | Application log level.
# Production normally uses INFO or WARNING.
# QRP_LOG_LEVEL=INFO

# --- API ---------------------------------------------------------------------
# Optional | hostname/IP | default: 127.0.0.1 | API listen address.
# Production may use 0.0.0.0 behind a firewall/reverse proxy.
# QRP_API_HOST=0.0.0.0
# Optional | integer 1..65535 | default: 8000 | API listen port.
# QRP_API_PORT=8000
# Optional | comma-separated HTTP(S) origins or * | default: * | Browser CORS allowlist.
# Production should list explicit HTTPS origins instead of *.
# QRP_API_CORS_ORIGINS=https://atlas.example.com

# --- Authentication ----------------------------------------------------------
# Optional | enum(local,database) | default: local | Local single-user or PostgreSQL auth.
# Production/persistent multi-user deployments should use database.
# QRP_AUTH_MODE=database
# Optional | UUID | default: stable v1.0 local-user UUID | Local mode only.
# QRP_LOCAL_USER_ID=00000000-0000-4000-8000-000000000001
# Optional | string | default: existing v1.0 local identity | Local mode login identity; not a secret.
# QRP_LOCAL_USERNAME=local-user
# Optional | string | default: existing v1.0 local display name | Local mode display name; not a secret.
# QRP_LOCAL_DISPLAY_NAME=Local User
# Conditionally required | PostgreSQL URL | no default | Required when QRP_AUTH_MODE=database.
# SECRET: inject securely; never commit a real DSN or password.
# QRP_AUTH_DATABASE_URL=postgresql://USER:PASSWORD@db.example.com:5432/qrp_atlas
# Optional | positive integer seconds | default: 604800 | Session lifetime.
# Production should choose a value matching the security policy.
# QRP_AUTH_SESSION_TTL_SECONDS=604800

# --- Tushare and outbound networking ----------------------------------------
# Optional globally; required when using Tushare | string | no default.
# SECRET: inject securely; never commit a real token.
# TUSHARE_TOKEN=replace-with-secure-injection
# Optional | absolute HTTP(S) URL | default: https://fastapic.stockai888.top | Tushare-compatible API.
# QRP_TUSHARE_API_URL=https://api.example.com
# Optional | finite number >= 0, seconds | default: 0.6 | Minimum request interval.
# QRP_TUSHARE_REQUEST_INTERVAL_SECONDS=0.6
# Optional | integer >= 0 | default: 0 | Retry count after the first attempt.
# QRP_TUSHARE_MAX_RETRIES=0
# Optional | finite number >= 0, seconds | default: 1.0 | Linear retry backoff base.
# QRP_TUSHARE_RETRY_BACKOFF_SECONDS=1.0
# Optional | absolute HTTP(S) URL | no default | Outbound HTTP proxy.
# SECRET when credentials are embedded; prefer service-manager injection.
# QRP_HTTP_PROXY=http://proxy.example.com:8080
# Optional | absolute HTTP(S) URL | no default | Outbound HTTPS proxy.
# SECRET when credentials are embedded; prefer service-manager injection.
# QRP_HTTPS_PROXY=http://proxy.example.com:8080
# Optional | comma-separated/string host bypass list | no default | NO_PROXY value.
# QRP_NO_PROXY=localhost,127.0.0.1

# --- Temporary remote-access tool -------------------------------------------
# Optional | file path | default: <QRP_HOME>/.runtime/remote_access/token | Generated bearer-token file.
# File contents are secret; configure only the path here.
# QRP_REMOTE_ACCESS_TOKEN_FILE=/srv/qrp-atlas/runtime/remote_access/token
# Optional | file path | default: <QRP_DUCKDB_PATH> | Read-only database exposed by the tool.
# QRP_REMOTE_ACCESS_DB_PATH=/srv/qrp-atlas/data/db/quant.db
# Optional | integer 1..65535 | default: 8765 | Loopback gateway port.
# QRP_REMOTE_ACCESS_PORT=8765

# --- System B episode / pool databases (cross-database ATTACH) ---------------
# Optional | file path | no default | Episode pipeline output database.
# Produced by rebuild_episodes --output-database.  When configured, the API
# ATTACHes this file read-only as "episode_db" to enable the /active-episodes
# endpoint.  Must be an absolute POSIX path on the Linux server.
# QRP_EPISODE_DB_PATH=/srv/qrp-atlas/data/db/episode.duckdb
# Optional | file path | no default | Pool pipeline output database.
# Produced by build_stock_pools --output-database.  When configured, the API
# ATTACHes this file read-only as "pool_db" to enable the /pools/snapshot
# endpoints.  Must be an absolute POSIX path on the Linux server.
# QRP_POOL_DB_PATH=/srv/qrp-atlas/data/db/pool.duckdb

# --- Isolated versioned lake (disabled unless explicitly configured) --------
# Optional | absolute directory | no default | Separate Raw, catalog data,
# staging and worker artifacts; must not overlap production legacy data paths.
# QRP_LAKE_ROOT=/srv/qrp-atlas-lake-shadow
# Required for lake writers | DuckLake catalog connection | no default.
# SECRET: use a separate core PostgreSQL database/role; inject the real DSN.
# QRP_LAKE_CORE_CATALOG=postgres:dbname=qrp_core host=db.example.com user=CORE_WRITER password=SECRET
# Required for extension writers | DuckLake catalog connection | no default.
# SECRET: separate extension database/role; must not equal the core catalog.
# QRP_LAKE_EXTENSION_CATALOG=postgres:dbname=qrp_extensions host=db.example.com user=EXTENSION_WRITER password=SECRET
# Required for extension/API core reads | catalog connection | no default.
# SECRET: core catalog with a read-only role; do not give extensions core writer credentials.
# QRP_LAKE_CORE_READ_CATALOG=postgres:dbname=qrp_core host=db.example.com user=CORE_READER password=SECRET
# Optional | integer 1..12 | default: 2 | DuckDB threads per worker.
# QRP_LAKE_THREADS=2
# Optional | positive integer MB/GB | default: 4GB | DuckDB buffer budget,
# not the Python process hard memory limit; also configure worker/cgroup limits.
# QRP_LAKE_MEMORY_LIMIT=4GB
# Optional | enum(legacy,lake) | default: legacy | Explicit API daily-data route.
# No implicit fallback; lake mode requires a root and pinned snapshot.
# QRP_LAKE_DAILY_SOURCE=legacy
# Optional | boolean | default: false | Explicit restored catalog path override; only for a verified restored files directory.
# QRP_LAKE_RELOCATED=false
# Required when DAILY_SOURCE=lake | nonnegative integer | no default.
# A fixed published core DuckLake snapshot; never an implicit latest version.
# QRP_LAKE_DAILY_SNAPSHOT=1

# --- Isolated lake worker budgets (non-secret) ------------------------------
# Optional | positive finite seconds | default: 1800 | One subprocess deadline.
# QRP_LAKE_WORKER_TIMEOUT_SECONDS=1800
# Optional | positive bytes | default: 8589934592 | Sampled process-tree RSS limit.
# Linux cgroups are additionally required for hard memory isolation.
# QRP_LAKE_WORKER_MEMORY_BYTES=8589934592
# Optional | positive bytes | default: 17179869184 | Per-attempt temp/log budget.
# Filesystem quotas are additionally required for hard disk isolation.
# QRP_LAKE_WORKER_TEMP_BYTES=17179869184
# Optional | ISO date | default: 2026-01-01 | Earliest Dagster daily partition.
# QRP_LAKE_PARTITION_START_DATE=2026-01-01
# Optional | integer 0..23 | default: 18 | Asia/Shanghai daily schedule hour.
# Definition is present but STOPPED until explicitly enabled after acceptance.
# QRP_LAKE_SCHEDULE_HOUR=18
# Optional | absolute file path | no default | Operator-owned enabled plugin JSON.
# QRP_LAKE_PLUGINS_FILE=/etc/qrp-lake/enabled-plugins.json
# Optional | true/false | default: false | Explicit observed-data research policy.
# This does not confer historical PIT evidence or permit strict-PIT decisions.
# QRP_LAKE_ALLOW_OBSERVED=false
